# Copie para .env e preencha.
# ID de afiliado do Booking.com (programa de afiliados). Vazio = link sem comissão.
VITE_BOOKING_AID=
# Domínio cadastrado no Plausible Analytics, para medir usuário ativo. Vazio = sem métrica.
VITE_PLAUSIBLE_DOMAIN=
# Link de afiliado de um comparador de seguro viagem (ex.: programa de afiliados de um comparador brasileiro).
# Vazio = o app mostra as dicas de seguro, sem botão.
VITE_SEGURO_URL=
