# Copie para .env e preencha.
# ID de afiliado do Booking.com (programa de afiliados). Vazio = link sem comissão.
VITE_BOOKING_AID=
# Domínio cadastrado no Plausible Analytics, para medir usuário ativo. Vazio = sem métrica.
VITE_PLAUSIBLE_DOMAIN=
# Link de afiliado de um comparador de seguro viagem (ex.: programa de afiliados de um comparador brasileiro).
# Vazio = o app mostra as dicas de seguro, sem botão.
VITE_SEGURO_URL=
# Mapa de fundo (endereço dos "tiles" no formato {z}/{x}/{y}) e crédito obrigatório do provedor.
# Vazio = OpenStreetMap, que serve só para uso leve. Para o lançamento, use um provedor com plano grátis
# e chave (ex.: MapTiler ou Stadia Maps) e ponha aqui o endereço e o crédito que o provedor indicar.
VITE_MAPA_TILES=
VITE_MAPA_CREDITO=
# Chave da Google Maps Embed API (grátis e sem limite de uso; precisa de conta no Google Cloud).
# Restrinja a chave ao domínio do app. Vazio = incorporação clássica do Google Maps (serve para teste).
VITE_GOOGLE_MAPS_KEY=
# Supabase (grupos, chat e conta). Settings → API no painel do Supabase.
# A chave "anon public" é pública e vai no app. NUNCA ponha a chave "service_role" aqui.
# Vazio = modo demonstração (tudo fica no aparelho).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
